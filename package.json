{
  "name": "@log.li/dsh-memory",
  "description": "Long-term memory plugin for DeepSeek Harness: persistent cross-session markdown memory, injected at session start as rules plus a one-line hot index, with memory_search / memory_read / memory_write tools, optional end-of-turn extraction (on by default) and portable migration tooling. Memory only — no persona.",
  "version": "0.8.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-memory": "scripts/memory.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/**",
    "skills/**",
    "scripts/**",
    "docs/**",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/memory.mjs --self-test",
    "test:plugin": "node --test",
    "lint:memory": "node scripts/memory.mjs lint"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "memory",
    "long-term-memory",
    "markdown",
    "wiki",
    "migration"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/log-li/dsh-memory.git"
  },
  "bugs": {
    "url": "https://github.com/log-li/dsh-memory/issues"
  },
  "homepage": "https://github.com/log-li/dsh-memory#readme",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
